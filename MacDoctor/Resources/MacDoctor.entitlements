<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Intentionally empty.

	  App Sandbox is OFF because process enumeration and signalling require
	  access to other processes. Mac Doctor never asks for root, installs no
	  privileged helper, and uses no kernel extensions. Hardened Runtime is
	  enabled in the target build settings (ENABLE_HARDENED_RUNTIME = YES).
	-->
</dict>
</plist>
